# Copy to .env.local and fill in from Supabase → Project settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voyage AI (embeddings) — https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Anthropic (key facts, question generation) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Run the Claude calls through Amazon Bedrock instead of
# Anthropic's own API — same model, AWS account, AWS billing.
#
# Setting AWS_BEDROCK_REGION is what switches providers; unset it to go
# back. The token is a Bedrock API key from the AWS console, and note
# that generating one is not the same as being allowed to use a model:
# access is granted per region AND the Anthropic use case details form
# has to be submitted, or every call returns 404 saying so.
#
#   AWS_BEDROCK_REGION=eu-west-1
#   AWS_BEARER_TOKEN_BEDROCK=
#   ANTHROPIC_MODEL=global.anthropic.claude-sonnet-4-6
#
# Bedrock ids carry a routing prefix the first-party API rejects:
# "global." goes wherever there is capacity at no premium, a regional
# prefix like "eu." pins the region for 10% more.
#
# Check either provider with: npx tsx scripts/check-anthropic.mts
AWS_BEDROCK_REGION=
AWS_BEARER_TOKEN_BEDROCK=
ANTHROPIC_MODEL=

# true = pilot mode, everyone gets full access; false = free tier sees the
# sampler + paywall (subscriptions arrive with Stripe in Phase 7)
BETA_FULL_ACCESS=true

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=
STRIPE_FOUNDING_COUPON=

# false = private/dev (no indexing, sign-ups closed); true = live
NEXT_PUBLIC_LAUNCHED=false

# Set to hide the whole site behind an access code during development.
SITE_GATE_PASSWORD=

# Lets the daily Vercel cron drive the generation queue without a
# session. Any long random string; set the same value in Vercel.
CRON_SECRET=

# Resend — daily reminder email. RESEND_FROM must be an address on a
# domain verified in Resend, e.g. "Pinard <hello@pinardapp.com>".
RESEND_API_KEY=
RESEND_FROM=

# Absolute URL for links that leave the app: Stripe return URLs and
# the reminder email buttons. Without it a cron falls back to the
# Vercel deployment URL, which is not your domain — set it in production.
NEXT_PUBLIC_SITE_URL=
