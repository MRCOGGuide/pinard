# Copy to .env.local and fill in from Supabase → Project settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voyage AI (embeddings) — https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Anthropic (key facts, question generation) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# true = pilot mode, everyone gets full access; false = free tier sees the
# sampler + paywall (subscriptions arrive with Stripe in Phase 7)
BETA_FULL_ACCESS=true

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=
STRIPE_FOUNDING_COUPON=

# false = private/dev (no indexing, sign-ups closed); true = live
NEXT_PUBLIC_LAUNCHED=false
